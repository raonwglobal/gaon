# Core
PORT=3000
ENABLED_PLUGINS=weather,echo
API_SECRET_TOKEN=
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=60
SESSION_IDLE_TIMEOUT_MS=1800000
MAX_SESSIONS=1000
PLUGINS_DIR=
PLUGIN_RUNTIME=inprocess
ORCHESTRATOR=endpoint
PLUGIN_RPC_TIMEOUT_MS=15000
SANDBOX_PLUGINS=false
LOG_BUFFER_SIZE=500
INSTANCE_ID=
CLUSTER_PEERS=

# Docker orchestrator
PLUGIN_PORT_MIN=18000
PLUGIN_PORT_MAX=18999
DOCKER_PLUGIN_HOST=127.0.0.1
DOCKER_PLUGIN_NETWORK=bridge
PLUGIN_MEMORY=256m
PLUGIN_CPUS=0.5

# K8s orchestrator
K8S_NAMESPACE=mcp-plugins
K8S_APPLY=false
K8S_CLUSTER_DOMAIN=svc.cluster.local

# Shared Control Plane <-> Core
INTERNAL_TOKEN=change-me-internal

# Control Plane
CONTROL_PORT=3001
ADMIN_TOKEN=change-me
CORE_URL=http://localhost:3000
DATABASE_PATH=./data/platform.json

# Dashboard (injected into browser via /config.json at container start)
# Use the same value as Control Plane ADMIN_TOKEN
# ADMIN_TOKEN=change-me
